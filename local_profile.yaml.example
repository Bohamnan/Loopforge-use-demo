# 本人角色配置，不提交 git，仅本地生效
# 复制此文件为 local_profile.yaml 并填写

role: backend   # 可选值：backend | frontend | dev-lead | ba | qa
name: 姓名

code_roots:
  # 填写你负责的域的代码仓库根目录（即该仓库 AGENTS.md 所在目录），无权限的域注释掉；新项目的目录可以暂不存在
  backend: /path/to/backend-repo
  frontend: /path/to/frontend-repo

# 示例：
# role: backend
# name: 张三
# code_roots:
#   backend: /Users/zhangsan/projects/hr-collection-agent
#   # frontend: # 本人无权限，不填
